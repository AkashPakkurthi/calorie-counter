# --- AI provider -----------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Point at any OpenAI-compatible provider. For Groq:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_BASE_URL=

# --- database --------------------------------------------------------------
# SQLite locally; a Postgres URL (e.g. Neon) when hosted without a disk.
DATABASE_URL=sqlite:///./calories.db

# --- accounts --------------------------------------------------------------
# Signs session cookies. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# Leave blank locally and a temporary one is used (you get logged out on restart).
SECRET_KEY=
# Anyone registering must type this. Blank disables the gate -- on a public
# URL that lets strangers sign up and spend your API credits.
INVITE_CODE=
SESSION_DAYS=30
# Session cookies are marked Secure automatically when the request arrives over
# HTTPS, so plain-HTTP local development needs no setting. Only force this on if
# you knowingly serve a production site over HTTP.
INSECURE_COOKIES=false

APP_TZ=Asia/Kolkata

# --- daily email (optional) ------------------------------------------------
# Brevo's free tier covers 300 emails/day. Leave blank to disable email.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=Calorie Tracker
# Shared secret the scheduled job sends as the X-Cron-Token header. Blank
# leaves the endpoint closed.
CRON_TOKEN=
# Used for the button link inside the email.
APP_URL=https://your-app.onrender.com
